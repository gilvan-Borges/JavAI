<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.gilvanborges.javai</groupId>
        <artifactId>javai-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>javai-ai</artifactId>
    <packaging>pom</packaging>
    <name>JavAI · IA</name>
    <description>A IA: busca, indexador, chat e MCP. Só conhece o CRUD pelo snapshot público (spec 01).</description>

    <modules>
        <module>ai-core</module>
        <module>ai-migrations</module>
        <module>ai-embeddings</module>
        <module>ai-indexer</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ia-isolada-do-crud</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>br.com.gilvanborges.javai:admin-*</exclude>
                                    </excludes>
                                    <message>A IA não pode depender de módulos do CRUD (spec 01, "A regra de isolamento").</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
