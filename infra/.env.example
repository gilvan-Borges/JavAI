# Copie para infra/.env no servidor e rode: chmod 600 .env
# O .env nunca vai para o Git (está no .gitignore).
# Gere cada senha com: openssl rand -base64 32   (cada uma diferente; o admin-migrate recusa senha curta ou repetida)

# Tag das imagens no GHCR: o SHA do commit que o CI publicou.
JAVAI_TAG=

# Banco do CRUD
POSTGRES_ADMIN_PASSWORD=
ADMIN_OWNER_PASSWORD=
ADMIN_APP_PASSWORD=

# Banco da IA (Fase 2). Nunca reuse uma senha do banco do CRUD: o ai-migrate recusa senha curta ou repetida.
POSTGRES_AI_PASSWORD=
AI_OWNER_PASSWORD=
AI_INDEXER_PASSWORD=
AI_READER_PASSWORD=

# Cloudflare Access (Zero Trust > Access > Applications > admin.gilvanborges.com.br)
# <time> é o nome do time no Zero Trust; a AUD fica em "Overview" da aplicação.
ADMIN_ACCESS_JWKS_URI=https://<time>.cloudflareaccess.com/cdn-cgi/access/certs
ADMIN_ACCESS_ISSUER=https://<time>.cloudflareaccess.com
ADMIN_ACCESS_AUDIENCE=
ADMIN_OWNER_EMAIL=

# Opcional. URL do deploy hook do portfólio: é um segredo, quem tem dispara builds.
ADMIN_PORTFOLIO_DEPLOY_HOOK=

# Chat (Fase 4). Sem estes valores o chat responde 503 de manutenção; o MCP não depende deles.
# Chave do OpenRouter: exclusiva deste projeto e com limite de crédito mensal definido no painel do OpenRouter.
OPENROUTER_API_KEY=
# Chave SECRETA do Cloudflare Turnstile (a chave do site, pública, fica no portfólio).
TURNSTILE_SECRET=
# Hostnames aceitos no token (padrão: o portfólio). Acrescente localhost só para testar o portfólio local.
# TURNSTILE_HOSTNAMES=gilvanborges.com.br,www.gilvanborges.com.br,localhost
# Segredo que assina o histórico do chat e deriva as chaves do dia (openssl rand -base64 48). Vazio = aleatório a
# cada partida, e os turnos assinados antes de reiniciar deixam de valer.
HISTORY_SECRET=
# Modelos do OpenRouter, o principal primeiro e os fallbacks depois, separados por vírgula. Um modelo só entra aqui
# depois de passar na bateria de avaliação (specs/05-avaliacao.md).
JAVAI_MODELS_FAST=
JAVAI_MODELS_STRONG=
# Opcional. Teto de preço por milhão de tokens de saída (US$) e teto de gasto por dia (US$).
JAVAI_MAX_PRICE_COMPLETION=0
JAVAI_DAILY_BUDGET_USD=1.00
# Página /admin da IA (https://api.gilvanborges.com.br/admin): o que a IA pode consultar, o RAG, o uso e a segurança.
# Só leitura. Usuário com 3+ caracteres e senha com 16+; sem os dois a rota responde 404. Gere a senha com
# `openssl rand -base64 24`. Trocar a senha derruba todas as sessões abertas.
ADMIN_UI_USER=
ADMIN_UI_PASSWORD=

# Chave de emergência: false desliga o chat sem derrubar o MCP.
JAVAI_CHAT_ENABLED=true

# Opcional. Onde o ai-indexer lê o snapshot do CRUD (padrão: o endereço público).
INDEXER_SNAPSHOT_BASE_URL=

# ---- Fontes públicas da IA (tudo opcional; é o que o ai-indexer lê além do CRUD) -------------------------------
# Quem clonar o projeto troca estes endereços pelos seus. O texto entra no índice literalmente, com o link de origem.
# Site principal (entra como link).
INDEXER_SOURCES_SITE_URL=
# Textos do site em .txt/.md/.html, separados por vírgula. Site feito em SPA precisa publicar um llms-full.txt.
INDEXER_SOURCES_SITE_DOCUMENTS=
# Documentos públicos em PDF ou texto (o currículo), separados por vírgula.
INDEXER_SOURCES_DOCUMENTS=
# Usuários do GitHub: perfil, README do perfil e lista de repositórios públicos.
INDEXER_SOURCES_GITHUB_USERS=
# Repositórios extras (dono/nome) cujo conteúdo a IA lê, além dos ligados no CRUD.
INDEXER_SOURCES_GITHUB_REPOS=
# true = lê o conteúdo de TODOS os repositórios públicos (sem fork/arquivados) dos usuários acima, até o máximo.
INDEXER_SOURCES_GITHUB_DISCOVER=false
INDEXER_SOURCES_GITHUB_EXCLUDE=
INDEXER_SOURCES_GITHUB_MAX_REPOS=30
# O LinkedIn não permite leitura automática: entra só como link.
INDEXER_SOURCES_LINKEDIN_URL=
# Token da porta interna do botão "reindexar" do /admin. Gere com `openssl rand -hex 24`. Vazio = botão desligado.
INDEXER_TRIGGER_TOKEN=

# Endereço público do CRUD (ex.: https://admin.seudominio.com). A tela "Treinar" da IA usa para o botão "Corrigir no CRUD".
CRUD_PUBLIC_URL=

# Ajustes finos do chat. Todos têm padrão no código (os valores abaixo são esses padrões): só preencha para mudar.
# JAVAI_MAX_TOKENS=300             # teto de tokens por resposta
# JAVAI_REASONING_EFFORT=          # low | medium | high; vazio = o modelo decide (modelos de raciocínio gastam max_tokens pensando)
# JAVAI_ZDR=false                  # true = só provedores com Zero Data Retention
# JAVAI_PER_MINUTE=3               # perguntas por minuto por IP
# JAVAI_PER_DAY=0                  # perguntas por dia por IP; 0 = sem limite diário
# JAVAI_BAN_HOURS=12               # quanto dura o bloqueio de quem tenta atacar; 0 = desliga
# JAVAI_BAN_CONFIDENCE=0.90        # confiança do Jev que bloqueia na hora
# JAVAI_BAN_STRIKES=3              # tentativas de confiança menor que levam ao bloqueio
# JAVAI_JEV_TIMEOUT_MS=800         # prazo do classificador antes de seguir sem ele
# JAVAI_CORS_ORIGIN=https://gilvanborges.com.br   # única origem de navegador aceita no chat
