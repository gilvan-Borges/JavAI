# Caddy da VPS (spec 01, "Caddy"). Só a Cloudflare chega aqui: o firewall da Hostinger aceita a 443 só das
# faixas dela, e o Authenticated Origin Pulls recusa qualquer TLS sem o certificado de cliente da Cloudflare.
# Host que não está neste arquivo não é atendido.
{
	admin off
	# Os certificados são os de origem da Cloudflare, em arquivo: nada de ACME, nada na porta 80.
	auto_https off
	https_port 8443

	servers {
		# Faixas da Cloudflare em 2026-10-02 (https://www.cloudflare.com/ips). Revisar a cada trimestre.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		protocols h1 h2
	}

	log {
		output stdout
		format json
	}
}

(cloudflare_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}
}

(cabecalhos) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# CRUD privado. O Cloudflare Access autentica antes; o admin-api ainda valida o JWT.
https://admin.gilvanborges.com.br {
	import cloudflare_tls
	import cabecalhos
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		Cache-Control "no-store"
	}
	request_body {
		max_size 256KB
	}
	# Só a porta 8080. O actuator, na 8081, nunca é roteado.
	reverse_proxy admin-api:8080
}

# Snapshot público do CRUD: dois arquivos estáticos, só leitura. O admin-api não é alcançado por aqui.
https://conteudo.gilvanborges.com.br {
	import cloudflare_tls
	import cabecalhos

	@snapshot {
		method GET HEAD
		path /v1/snapshot/pt.json /v1/snapshot/en.json
	}
	handle @snapshot {
		root * /srv/conteudo
		header {
			Cache-Control "public, max-age=300"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}
		file_server
	}
	handle {
		respond 404
	}
}

# API pública da IA. Na Fase 3 só existe o MCP (POST /mcp); o resto responde 404. O ai-api fica numa rede interna
# só com o Caddy, então nada chega a ele sem passar por aqui. O IP real (da Cloudflare) vai no X-Real-IP, que o
# ai-api usa no rate limit; header_up substitui qualquer valor que o cliente tenha mandado.
https://api.gilvanborges.com.br {
	import cloudflare_tls
	import cabecalhos
	header {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Cache-Control "no-store"
	}
	request_body {
		max_size 64KB
	}

	@mcp path /mcp
	handle @mcp {
		# Só a porta 8080. O actuator, na 8081, nunca é roteado.
		reverse_proxy ai-api:8080 {
			header_up X-Real-IP {http.request.client_ip}
			transport http {
				dial_timeout 3s
				response_header_timeout 20s
			}
		}
	}
	handle {
		respond 404
	}
}
